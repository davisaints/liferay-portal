@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {	
		task ("Go to Documents and Media and add new document") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentFile = "Document_1.txt",
				dmDocumentTitle = "DM Document Title");
		}
		
		task ("Add widget and publish") {
			Navigator.gotoPage(pageName = "Home");

			Click(locator1 = "MyDMTests#BUTTON_EDIT_PAGE");

			PageEditor.addWidgetViaKeyboard(
				categoryName = "Highlighted",
				widgetName = "Documents and Media");

			PortletEntry.publish();
		}

		task ("View text document") {
			DMDocument.viewPG(dmDocumentTitle = "DM Document Title");
		}
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		task ("Go to Documents and Media and add two document") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document1 Title");

			DMDocument.addCP(
			dmDocumentFile = "Document_2.txt",
			dmDocumentTitle = "DM Document2 Title");
		}
		
		task ("Add widget and publish") {
			Navigator.gotoPage(pageName = "Home");

			Click(locator1 = "MyDMTests#BUTTON_EDIT_PAGE");

			PageEditor.addWidgetViaKeyboard(
				categoryName = "Highlighted",
				widgetName = "Documents and Media");
		}

		task ("Go to Documents and Media and delete DM Document1") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.deleteCP(dmDocumentTitle = "DM Document1 Title");
		}

		task ("Assert if Document1 is deleted and Document2 is present ") {
			AssertElementNotPresent(
			key_dmDocumentTitle = "DM Document1 Title",
			locator1 = "DocumentsAndMedia#PAGE_DOCUMENT_TITLE");

			AssertElementPresent(
				key_dmDocumentTitle = "DM Document2 Title",
				locator1 = "DocumentsAndMedia#PAGE_DOCUMENT_TITLE");
		}
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		task ("Go to Documents and Media and add two document") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document1 Title");

			DMDocument.addCP(
			dmDocumentFile = "Document_2.txt",
			dmDocumentTitle = "DM Document2 Title");
		}

		task ("Add widget and publish") {
			Navigator.gotoPage(pageName = "Home");

			Click(locator1 = "MyDMTests#BUTTON_EDIT_PAGE");

			PageEditor.addWidgetViaKeyboard(
				categoryName = "Highlighted",
				widgetName = "Documents and Media");
		}

		task ("Go to Documents and Media and download DM Document1") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.downloadPG(dmDocumentTitle = "DM Document1 Title");
		}

		task ("Assert if Document1 	was downloaded and Document2 was not downloaded ") {
			DMDocument.assertFileNameFromTempFolder(fileName = "Document_1.txt");

			DMDocument.assertNoFileNameFromTempFolder(fileName = "Document_2.txt");
		}	
	}

}